# Satark Nepal Environment Variables Example

# Supabase Setup (Optional - built-in client offline fallback active if empty)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Weather API (Optional - Open-Meteo free API used by default with offline fallback)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Satark AI Provider (Optional - rule-based fallback active if empty)
AI_PROVIDER=gemini
AI_API_KEY=

# SMS Fallback Provider (Optional - local queue fallback active if empty)
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_FROM_NUMBER=

# Application Config
NEXT_PUBLIC_APP_NAME="Satark Nepal"
NEXT_PUBLIC_APP_NAME_NP="सतर्क नेपाल"